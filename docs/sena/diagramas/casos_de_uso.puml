@startuml casos_de_uso
' Diagrama general de casos de uso de AgroConecta (DIA-CU-01)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F9F2
  BorderColor #3B6E2F
}

actor "Productor\n(ACT-01)" as Productor
actor "Comprador\n(ACT-02 consumidor /\nACT-03 negocio)" as Comprador
actor "Administrador\n(ACT-04)" as Admin
actor "Wompi\n(ACT-06)" as Wompi <<sistema>>
actor "Planificador de tareas\n(ACT-07)" as Planificador <<sistema>>

rectangle "AgroConecta" {
  usecase "CU-001\nRealizar pedido y pago" as CU1
  usecase "CU-002\nGestionar ciclo del pedido" as CU2
  usecase "CU-003\nResolver disputa" as CU3
  usecase "CU-004\nLiquidar saldo" as CU4

  usecase "Gestionar carrito\n(HU-011)" as H11
  usecase "Iniciar pago en línea\n(HU-018)" as H18
  usecase "Procesar webhook\n(HU-019)" as H19
  usecase "Acreditar saldo\n(HU-020)" as H20
  usecase "Ejecutar reembolso\n(HU-023)" as H23
  usecase "Aplicar plazos\n(HU-017)" as H17
}

Comprador --> CU1
Comprador --> CU2
Comprador --> CU3
Productor --> CU2
Productor --> CU4
Admin --> CU3
Admin --> CU4

CU1 ..> H11 : <<include>>
CU1 ..> H18 : <<include>>
H19 <-- Wompi
CU1 ..> H19 : <<include>>
CU2 ..> H20 : <<include>>
CU2 ..> H17 : <<include>>
H17 <-- Planificador
CU3 ..> H23 : <<include>>
H23 --> Wompi
@enduml
